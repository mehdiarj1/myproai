{
  "name": "siderail",
  "version": "1.0.0",
  "private": true,
  "description": "SideRail - neobrutalist control panel with one-click Railway deploy",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "apps/server"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,server -c magenta,cyan \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "cd apps/web && npm run dev",
    "dev:server": "npm run dev --workspace apps/server",
    "build": "npm run build:server",
    "build:web": "cd apps/web && npm run build",
    "build:server": "npm run build --workspace apps/server",
    "start": "node apps/server/dist/index.js",
    "typecheck": "npm run typecheck --workspace apps/web && npm run typecheck --workspace apps/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
